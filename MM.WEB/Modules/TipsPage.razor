@page "/{culture}/tips"

@inherits PageCore<TipsPage>

<HeadComponent Title="Tips" Url=@($"/{Culture}/tips") Index="false"></HeadComponent>
<PageSectionComponent IsPageHeader="true" Title="Tips"></PageSectionComponent>

<PageSectionComponent ShowHeader="false">
    <ActionsFragment>
        <MudSelect Label="Filter" FitContent="!AppStateStatic.IsMobile" Clearable="true" Dense="true" Class="me-2" Variant="Variant.Text"
                   Value="@filter" ValueChanged="@((string? vl) => { filter = vl; StateHasChanged(); })">
            @foreach (var item in Options)
            {
                <MudSelectItem Value="item">
                    @item
                </MudSelectItem>
            }
        </MudSelect>
    </ActionsFragment>
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            @foreach (var item in CategoryList)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard>
                        <MudCardHeader Class="pa-2">
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6" Color="Color.Primary">
                                    @item.Placeholder
                                </MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardActions Class="pa-2">
                            <MudButton Variant="Variant.Text" Href="@($"/{Culture}/tips/{item.Value.ToString().ToSlug()}")">
                                @($"Tips")
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>