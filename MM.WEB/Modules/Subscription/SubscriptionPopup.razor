@inherits ComponentCore<SubscriptionPopup>

@inject PaymentAuthApi PaymentAuthApi
@inject PrincipalApi PrincipalApi
@inject IpInfoApi IpInfoApi
@inject ILogger<SubscriptionPopup> Logger

<MudDialog Style="width: 100%">
    <DialogContent>
        @if (BlockedCountry)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                @($"Unfortunately, due to legal and policy restrictions, we are unable to offer our services in {_XoloBlockedCountries[CurrentCountry!.ToUpper()]}.")
            </MudAlert>
        }
        else if (AppStateStatic.IsAuthenticated && (Client == null))
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100px" Animation="Animation.Wave" />
        }
        else
        {
            <MudGrid Spacing="@CssHelper.SpaceSmall" Class="@CssHelper.Build().Small("mb")" Style="align-items: end;">
                <MudItem xs="12" sm="8">
                    @if (AppStateStatic.ActiveProduct == AccountProduct.Phase1)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" NoIcon="true">
                            We’re in pre-launch. Buy Sparks now at the lowest price and use them when we go live.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" NoIcon="true">
                            Get Sparks at the current price. The price increases in the next phase as more users join.
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="@Provider" Label="@Translations.Module.Subscription.PaymentProvider" Variant="Variant.Outlined" Dense="true">
                        @foreach (var item in Providers)
                        {
                            <MudSelectItem T="PaymentProvider" Value="@item">
                                @item.GetFieldSettings().Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (Provider == PaymentProvider.Microsoft)
            {
                if (Platform == MM.Shared.Enums.Platform.windows)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The Microsoft subscription option isn’t available yet. Stay tuned for updates!
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The Microsoft subscription option is only available in the Windows application.
                    </MudAlert>
                }
            }
            else if (Provider == PaymentProvider.Apple)
            {
                if (Platform == MM.Shared.Enums.Platform.ios)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="@CssHelper.Build().Small("mb")">
                        Apple subscription is still in testing. If you run into any issues, please reach out via feedback or email. We’re happy to help.
                    </MudAlert>

                    <SubscriptionPlansComponent Provider="Provider" Client="Client"></SubscriptionPlansComponent>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The Apple subscription option is only available on iOS devices.
                    </MudAlert>
                }
            }
            else if (Provider == PaymentProvider.Google)
            {
                if (Platform == MM.Shared.Enums.Platform.play)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The Google subscription option isn’t available yet. Stay tuned for updates!
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The Google subscription option is only available on Android devices.
                    </MudAlert>
                }
            }
            else if (Provider == PaymentProvider.Paddle)
            {
                <FeatureUnavailable></FeatureUnavailable>
            }
            else if (Provider == PaymentProvider.Stripe)
            {
                @if (Platform == MM.Shared.Enums.Platform.amazon)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        @($"Unfortunately, due to legal and policy restrictions, we are unable to offer our services in Amazon devices.")
                    </MudAlert>
                }
                else if (CurrentCountry.NotEmpty() && _StripeBlockedCountries.ContainsKey(CurrentCountry.ToUpper()))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        @($"Unfortunately, due to legal and policy restrictions, Stripe cannot offer payment services in {_StripeBlockedCountries[CurrentCountry!.ToUpper()]}.")
                    </MudAlert>
                }
                else
                {
                    <SubscriptionPlansComponent Provider="Provider" Client="Client"></SubscriptionPlansComponent>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <span class="ma-2">Platform: @Platform</span>
        <MudSpacer></MudSpacer>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>