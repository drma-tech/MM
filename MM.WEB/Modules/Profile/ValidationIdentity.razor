@page "/{culture}/profile/validation/identity"
@using MM.WEB.Modules.Profile.Core
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inherits PageCore<ValidationIdentity>

@inject ValidationApi ValidationApi

<HeadComponent Title="@Translations.Title.Profile" Url=@($"/{Culture}/profile/validation/identity") Index="false"></HeadComponent>

<MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="@CssHelper.Build().Small("my")">
    @Translations.Notification.ModuleUnderDevelopment
</MudAlert>

<MudAlert Variant="Variant.Filled" Severity="Severity.Warning" Dense="true" Icon="@IconsFA.Solid.Icon("spinner").Animation(IconAnimation.Spin).Font">
    Redirection in progress... Please wait.
</MudAlert>

<FloatingButton Template="Template.Back"></FloatingButton>