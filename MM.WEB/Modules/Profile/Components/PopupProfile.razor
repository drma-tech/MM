@using MM.Shared.Models.Profile
@using MM.WEB.Modules.Auth.Core
@using MM.WEB.Modules.Profile.Core
@using Microsoft.AspNetCore.Authorization
@inherits ComponentCore<PopupProfile>
@attribute [Authorize]

@inject ProfileApi ProfileApi
@inject PrincipalApi PrincipalApi
@inject FilterApi FilterApi
@inject InteractionApi InteractionApi

<MudDialog Style="width: 100%">
    <DialogContent>
        <RenderControl Actions="Actions" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated">
            <MudGrid Spacing="@CssHelper.SpaceSmall">
                @if (OnlyCompatibility)
                {
                    <MudItem xs="12" sm="6" md="4" Style="vertical-align: central;">
                        <MudPaper style="height: 100%;" Outlined="true">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                @Translations.Module.Profile.FeatureNotAvailable.CustomFormat(2)
                            </MudAlert>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="8">
                        <CardCompatibility User="user" Filter="filter" View="View" Affinities="affinities"></CardCompatibility>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper style="position: relative;" Outlined="true">
                            @{
                                var totPercAff = affinities.GetPercentAffinity();
                            }
                            <MudChip T="string" Color="GetColor(totPercAff)" Label="true" Class="poster-chip" Style="top: 5px; left: 5px; z-index: 2;" Size="AppStateStatic.Size">
                                @(totPercAff + "%")
                            </MudChip>
                            <MudChip T="string" Color="Color.Dark" Label="true" Class="poster-chip" Style="top: 5px; right: 5px; z-index: 2;"
                                     Icon="@Icons.Material.Filled.PhotoCamera" Size="AppStateStatic.Size">
                                @imageDataUriGallery.Count()
                            </MudChip>
                            <MudCarousel Class="mud-width-full" Style="height: 500px;" AutoCycle="true" ShowBullets="false" TData="string" ArrowsColor="Color.Primary">
                                <PreviousButtonTemplate>
                                    <MudIcon Icon="@IconsFA.Solid.Icon("circle-chevron-left").Font" Color="Color.Primary" Size="Size.Large" Class="ms-2" Style="cursor: pointer;"></MudIcon>
                                </PreviousButtonTemplate>
                                <NextButtonTemplate>
                                    <MudIcon Icon="@IconsFA.Solid.Icon("circle-chevron-right").Font" Color="Color.Primary" Size="Size.Large" Class="me-2" Style="cursor: pointer;"></MudIcon>
                                </NextButtonTemplate>
                                <ChildContent>
                                    @foreach (var item in imageDataUriGallery)
                                    {
                                        <MudCarouselItem>
                                            <MudImage Src="@item" FallbackSrc="images/no-face-photo.webp" Style="max-height: 400px !important; width: 100% !important;"></MudImage>
                                        </MudCarouselItem>
                                    }
                                </ChildContent>
                            </MudCarousel>
                            <div class="mb-2" style="text-align: center;">
                                <MudChip T="string" Color="Color.Primary" Label="true" Size="AppStateStatic.Size">
                                    @(View?.NickName ?? "NickName")
                                </MudChip>
                                <MudTooltip Text="@View?.Location">
                                    <MudChip T="string" Color="Color.Secondary" Label="true" Icon="@Icons.Material.Filled.Apartment" Size="AppStateStatic.Size">
                                        @(View?.GetLocation(LocationType.City) ?? "City")
                                    </MudChip>
                                </MudTooltip>
                                <MudText Typo="Typo.body1" Align="Align.Justify" Class="ma-2">
                                    @View?.Description
                                </MudText>
                            </div>
                            <MudGrid Spacing="@CssHelper.SpaceSmall" Class="pa-2">
                                <MudItem xs="6">
                                    <MudGrid Spacing="@CssHelper.SpaceSmall">
                                        @if (interaction?.Status != InteractionStatus.Explorer)
                                        {
                                            <MudItem xs="12">
                                                <DrmaButton Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Primary" Clicked="Like" Disabled="true || ButtonDisabled(EventType.Like)" Actions="EventActions">
                                                    @Translations.Button.Like
                                                </DrmaButton>
                                            </MudItem>
                                            <MudItem xs="12">
                                                <DrmaButton Icon="@Icons.Material.Filled.ThumbDown" Color="Color.Primary" Clicked="Like" Disabled="true || ButtonDisabled(EventType.Dislike)" Actions="EventActions">
                                                    @Translations.Button.Dislike
                                                </DrmaButton>
                                            </MudItem>
                                        }
                                        @if (interaction?.Status == InteractionStatus.Match || interaction?.Status == InteractionStatus.Dating)
                                        {
                                            <MudItem xs="12">
                                                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Chat" Style="width: 100%;"
                                                           OnClick="GoChat" Disabled="true">
                                                    @Translations.Button.Chat
                                                </MudButton>
                                            </MudItem>
                                        }
                                        @if (interaction?.Status == InteractionStatus.Match)
                                        {
                                            <MudItem xs="12">
                                                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PeopleAlt" Style="width: 100%;"
                                                           OnClick="GoChat" Disabled="ButtonDisabled(EventType.Dating)">
                                                    @Translations.Button.Dating
                                                </MudButton>
                                            </MudItem>
                                        }
                                        @if (interaction?.Status == InteractionStatus.Dating)
                                        {
                                            <MudItem xs="12">
                                                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Favorite" Style="width: 100%;"
                                                           OnClick="GoChat" Disabled="ButtonDisabled(EventType.Relationship)">
                                                    @Translations.Button.Relationship
                                                </MudButton>
                                            </MudItem>
                                        }
                                        @if (interaction?.Status == InteractionStatus.Dating || interaction?.Status == InteractionStatus.Relationship)
                                        {
                                            <MudItem xs="12">
                                                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Feedback" Style="width: 100%;"
                                                           OnClick="GoChat" Disabled="ButtonDisabled(EventType.Feedback)">
                                                    @Translations.Button.Feedback
                                                </MudButton>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudGrid Spacing="@CssHelper.SpaceSmall">
                                        <MudItem xs="12">
                                            <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" Style="width: 100%;"
                                                       OnClick="report!.ShowModal" Disabled="true">
                                                @Translations.Button.Delete
                                            </MudButton>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Flag" Style="width: 100%;"
                                                       OnClick="report!.ShowModal" Disabled="true">
                                                @Translations.Button.Report
                                            </MudButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                        @* @if (view.ActivityStatus == ActivityStatus.Today)
                        {
                        <Badge Color="Color.Success">
                        <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.DotCircle"></Blazorise.Icon> logado hoje
                        </Badge>
                        }
                        else if (view.ActivityStatus == ActivityStatus.Week)
                        {
                        <Badge Color="Color.Warning">
                        <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.DotCircle"></Blazorise.Icon> logado esta semana
                        </Badge>
                        }
                        else if (view.ActivityStatus == ActivityStatus.Month)
                        {
                        <Badge Color="Color.Danger">
                        <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.DotCircle"></Blazorise.Icon> logado este mês
                        </Badge>
                        }
                        else
                        {
                        <Badge Color="Color.Dark">
                        <Blazorise.Icon Name="Blazorise.Icons.FontAwesome.FontAwesomeIcons.DotCircle"></Blazorise.Icon> usuário desativado
                        </Badge>
                        } *@
                    </MudItem>
                    <MudItem xs="12" sm="6" md="8">
                        <CardCompatibility User="user" Filter="filter" View="View" Affinities="affinities"></CardCompatibility>
                    </MudItem>
                }
            </MudGrid>
            <ProfileReport @ref="report"></ProfileReport>
        </RenderControl>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="@(async () => { await DialogService!.ShowMessageBoxAsync("Feedback", Translations.Module.Profile.CompatibilityDeveloping); })">
            @Translations.Button.Feedback
        </MudButton>
        <MudButton OnClick="@(async () => { MudDialog!.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>