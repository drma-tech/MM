@typeparam TValue
@using System.Linq.Expressions
@using MM.Shared.Models.Profile
@using MM.WEB.Core.Enum
@using MM.WEB.Core.Models
@typeparam TValueUser

@inject IDialogService DialogService

@if (Values != null && Values.Any())
{
    foreach (var item in Values)
    {
        <MudItem xs="6" sm="12" md="12" lg="6">
            <MudChip T="string" Variant="Variant.Outlined" Size="AppStateStatic.Size" Color="GetColor(item)" Class="ma-0" Style="width: 100%; justify-content: space-between;">
                <MudIcon Icon="@ClassIcon" Style="margin-inline: -6px;"></MudIcon>
                <div>
                    <MudTooltip Text="@($"{For.GetFieldSettings(EnumFields.Name).Name}: {GetValue(item)}")">
                        <span style="text-decoration: underline; cursor: help;">
                            @GetValue(item).Truncate(15)
                        </span>
                    </MudTooltip>
                </div>
                <MudTooltip Text="Learn more">
                    <div @onclick="InstantiateModal">
                        <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Primary" Style="margin-inline: -6px; cursor: pointer; vertical-align: middle;"></MudIcon>
                    </div>
                </MudTooltip>
            </MudChip>
        </MudItem>
    }
}
else
{
    <MudItem xs="6" sm="12" md="12" lg="6">
        <MudChip T="string" Variant="Variant.Outlined" Size="AppStateStatic.Size" Color="GetColor(Value)" Class="ma-0" Style="width: 100%; justify-content: space-between;">
            <MudIcon Icon="@ClassIcon" Style="margin-inline: -6px;"></MudIcon>
            <div>
                <MudTooltip Text="@($"{For.GetFieldSettings(EnumFields.Name).Name}: {GetValue(Value)}")">
                    <span style="text-decoration: underline; cursor: help;">
                        @GetValue(Value).Truncate(15)
                    </span>
                </MudTooltip>
            </div>
            <MudTooltip Text="Learn more">
                <div @onclick="InstantiateModal">
                    <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Primary" Style="margin-inline: -6px; cursor: pointer; vertical-align: middle;"></MudIcon>
                </div>
            </MudTooltip>
        </MudChip>
    </MudItem>
}

@code {
    [Parameter] public Expression<Func<object>>? For { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public IEnumerable<TValue>? Values { get; set; }
    [Parameter] public TValueUser? ValueUser { get; set; }
    [Parameter] public IEnumerable<TValueUser>? ValuesUser { get; set; }
    [Parameter] public string? ClassIcon { get; set; }
    [Parameter] public List<AffinityVM> Affinities { get; set; } = [];

    [Parameter] public CompatibilityType Type { get; set; }
    [Parameter] public CompatibilityItem Item { get; set; }
    [Parameter] public ProfileModel? User { get; set; }
    [Parameter] public FilterModel? Filter { get; set; }

    private string GetValue(TValue? value)
    {
        if (value == null) return "Not Answered";
        if (value?.ToString() == "0") return "Not Answered";

        if (value is string resultS)
        {
            if (string.IsNullOrEmpty(resultS))
                return "Not Answered";
            return resultS;
        }

        if (value is int resultI)
        {
            if (resultI <= 0)
                return "Not Answered";
            return resultI.ToString();
        }

        if (value is Enum resultE)
        {
            var result = resultE.GetFieldSettings(EnumFields.Name).Name;

            if (string.IsNullOrEmpty(result))
                return "Not Answered";
            return result;
        }

        throw new InvalidOperationException("invalid type: " + value?.GetType());
    }

    private Color GetColor(TValue? value)
    {
        if (!Affinities.Any(s => s.Item == Item)) //if the attribute is not mapped to affinity, it remains neutral
        {
            return Color.Secondary;
        }

        if (Affinities.Single(s => s.Item == Item).HaveAffinity) //if it is mapped and has affinity
        {
            if (value == null)
            {
                return Color.Success;
            }

            if (value is Enum result && Type == CompatibilityType.Enum)
            {
                if (!GetExpectedValue().Any() || GetExpectedValue().Contains(result.GetFieldSettings(EnumFields.Name).Name))
                    return Color.Success;
                return Color.Warning;
            }

            return Color.Success;
        }

        //if mapped but without affinity
        return Color.Error;
    }

    public Task InstantiateModal()
    {
        if (Values == null && Value != null) Values = [Value];
        if (Values == null && Value == null) Values = [];

        var parameters = new DialogParameters<AboutItemModal<TValue>>
        {
            { x => x.PreferenceValues, GetPreferenceValues() },
            { x => x.ExpectedValues, GetExpectedValue() },
            { x => x.ViewValues, Values },
            { x => x.Affinities, Affinities },
            { x => x.Profile, User },
            { x => x.Type, Type },
            { x => x.Item, Item },
            { x => x.WhyImportant, For.GetFieldSettings(EnumFields.WhyImportant).WhyImportant },
            { x => x.Tips, For.GetFieldSettings(EnumFields.Tips).Tips },
        };

        return DialogService.ShowAsync<AboutItemModal<TValue>>(For.GetFieldSettings(EnumFields.Name).Name, parameters, PopupHelper.Options(MaxWidth.Medium));
    }

    private IEnumerable<string> GetPreferenceValues()
    {
        foreach (var item in ValuesUser ?? [ValueUser!])
        {
            if (item is Enum resultE)
            {
                yield return resultE.GetFieldSettings(EnumFields.Name).Name;
            }
            else if (item != null)
            {
                yield return item.ToString()!;
            }
        }
    }

    private IEnumerable<string?> GetExpectedValue()
    {
        if (User == null) return [];

        if (!GetPreferenceValues().Any()) return [];

        return Item switch
        {
            //BASIC
            CompatibilityItem.Location => AffinityCore.GetLocation(Filter, User.Location).loc.ToArray(),
            CompatibilityItem.Language => AffinityCore.GetLanguages(Filter, User.Languages).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.MaritalStatus => AffinityCore.GetMaritalStatus(Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.BiologicalSex => AffinityCore.GetBiologicalSex(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.GenderIdentities => AffinityCore.GetGenderIdentities(Filter, User.GenderIdentities).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.SexualOrientations => AffinityCore.GetSexualOrientations(Filter, User.SexualOrientations).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //BIO
            CompatibilityItem.Ethnicity => AffinityCore.GetEthnicity(Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.BodyType => AffinityCore.GetBodyType(Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Age => AffinityCore.GetAge(Filter, User.BirthDate).Select(s => s.ToString()),
            CompatibilityItem.Height => AffinityCore.GetHeight(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Neurodiversity => AffinityCore.GetNeurodiversity(Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Disabilities => AffinityCore.GetDisability(Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //LIFESTYLE
            CompatibilityItem.Drink => AffinityCore.GetDrink(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Smoke => AffinityCore.GetSmoke(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Diet => AffinityCore.GetDiet(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Religion => AffinityCore.GetReligion(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.FamilyInvolvement => AffinityCore.GetFamilyInvolvement(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.HaveChildren => AffinityCore.GetHaveChildren(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.HavePets => AffinityCore.GetHavePets(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.EducationLevel => AffinityCore.GetEducationLevel(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.CareerCluster => AffinityCore.GetCareerCluster(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.LivingSituation => AffinityCore.GetLivingSituation(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.TravelFrequency => AffinityCore.GetTravelFrequency(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.NetWorth => AffinityCore.GetNetWorth(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.AnnualIncome => AffinityCore.GetAnnualIncome(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //PERSONALITY
            CompatibilityItem.MoneyPersonality => AffinityCore.GetMoneyPersonality(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.SharedSpendingStyle => AffinityCore.GetSharedSpendingStyle(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.RelationshipPersonality => AffinityCore.GetRelationshipPersonality(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.MyersBriggsTypeIndicator => AffinityCore.GetMyersBriggsTypeIndicator(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.LoveLanguage => AffinityCore.GetLoveLanguage(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.SexPersonality => AffinityCore.GetSexPersonality(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //INTEREST
            CompatibilityItem.Food => AffinityCore.GetFood(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Vacation => AffinityCore.GetVacation(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Sports => AffinityCore.GetSports(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.LeisureActivities => AffinityCore.GetLeisureActivities(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.MusicGenre => AffinityCore.GetMusicGenre(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.MovieGenre => AffinityCore.GetMovieGenre(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.TVGenre => AffinityCore.GetTVGenre(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.ReadingGenre => AffinityCore.GetReadingGenre(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //RELATIONSHIP
            CompatibilityItem.SharedFinances => AffinityCore.GetSharedFinances(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.ConflictResolutionStyle => AffinityCore.GetConflictResolutionStyle(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.HouseholdManagement => AffinityCore.GetHouseholdManagement(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.TimeTogetherPreference => AffinityCore.GetTimeTogetherPreference(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.OppositeSexFriendships => AffinityCore.GetOppositeSexFriendships(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            //GOALS
            CompatibilityItem.RelationshipIntentions => AffinityCore.GetRelationshipIntentions(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.Relocation => AffinityCore.GetRelocation(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.WantChildren => AffinityCore.GetWantChildren(User, Filter).Select(s => s.GetFieldSettings(EnumFields.Name).Name),
            CompatibilityItem.IdealPlaceToLive => AffinityCore.GetIdealPlaceToLive(User).Select(s => s.GetFieldSettings(EnumFields.Name).Name),

            _ => throw new InvalidOperationException("invalid CompatibilityItem: " + Item)
        };
    }

}