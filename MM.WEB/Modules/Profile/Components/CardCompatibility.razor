        @Translations.Module.Profile.GeneralCompatibility (@(Affinities.GetPercentAffinity() + "%"))
    </MudText>
    @if (totPercAff <= 60)
    {
        @Translations.Module.Profile.CompatibilityLow
    }
    else if (totPercAff <= 80)
