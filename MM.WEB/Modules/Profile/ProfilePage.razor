<MudGrid Spacing="@CssHelper.SpaceSmall" Class="@CssHelper.Build().Small("mb")">
    <MudItem xs="12" sm="6" md="4">
        <ProfileStepsComponent Profile="@ProfileState.Instance" Filter="@FilterState.Instance" Setting="@SettingState.Instance"></ProfileStepsComponent>
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <ProfileSuggestionsComponent></ProfileSuggestionsComponent>
        <ProfileLikesComponent></ProfileLikesComponent>
        <ProfileMatchesComponent Profile="@ProfileState.Instance" Filter="FilterState.Instance"></ProfileMatchesComponent>
    </MudItem>
</MudGrid>

<style>
    .mud-stepper .mud-stepper-nav.mud-stepper-nav-scrollable .mud-step {
        width: 100%;
    }

    .mud-stepper .mud-stepper-nav .mud-step .mud-step-label {
        width: 100%;
    }
</style>