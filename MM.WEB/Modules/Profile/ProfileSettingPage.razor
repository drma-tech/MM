@page "/{culture}/profile/setting"

@attribute [Authorize]
@using MM.WEB.Api
@using Microsoft.AspNetCore.Authorization
@inherits PageCore<ProfileSettingPage>

@inject SettingApi SettingApi
@inject ProfileApi ProfileApi
@inject StorageApi StorageApi

<HeadComponent Title="@Translations.Title.Profile" Url=@($"/{Culture}/profile/setting") Index="false"></HeadComponent>

<RenderControl State="State" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated">
    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            <MudItem xs="12">
                <FieldSwitch Name="@MM.Shared.Translations.Model.ProfileSetting.BlindDate" Value="@context.BlindDate" ValueChanged="@((vl) => context.BlindDate = vl)" CssIcon="@IconsFA.Solid.Icon("eye-low-vision").Font"></FieldSwitch>
            </MudItem>
        </MudGrid>
    </MudStack>

    <div class="d-flex mt-6">
        <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveHandle" Class="me-2"
                   Disabled="@(Setting == null || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile)">
            @Translations.Button.Save
        </MudButton>
    </div>
</RenderControl>

<FloatingButton Template="Template.Back"></FloatingButton>