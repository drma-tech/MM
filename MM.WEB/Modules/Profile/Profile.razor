@page "/{culture}/profile"

@using Bogus
@using Country = MM.Shared.Enums.Country
@using FluentValidation
@using Height = MM.Shared.Enums.Height
@using MM.Shared.Models.Dashboard
@using MM.Shared.Models.Profile
@using MM.Shared.Models.Profile.Core
@using MM.WEB.Modules.Auth.Core
@using MM.WEB.Modules.Help
@using MM.WEB.Modules.Profile.Core
@using MM.WEB.Modules.Subscription.Core
@using MM.WEB.Shared.Core
@using Microsoft.JSInterop
@inherits PageCore<Profile>

@inject ProfileApi ProfileApi
@inject PrincipalApi PrincipalApi
@inject FilterApi FilterApi
@inject SettingApi SettingApi
@inject ValidationApi ValidationApi
@inject MyLikesApi MyLikesApi
@inject MyMatchesApi MyMatchesApi
@inject LastRegionUsersApi LastRegionUsersApi
@inject IpInfoApi IpInfoApi

<HeadComponent Title="@Translations.Title.Profile" Url=@($"/{Culture}/profile") Index="false"></HeadComponent>

@if (!AppStateStatic.IsAuthenticated)
{
    <MudPaper Class="@CssHelper.Build().Medium("pa").Large("mb").Raw("mud-theme-primary")" Outlined="true" Style="text-align: center;">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="my-3">
            @Translations.Module.Profile.HeroCall
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Login" Class="my-4">
            @Translations.Module.Profile.HeroButton
        </MudButton>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="my-3 d-block">
            @Translations.Module.Profile.HeroNote
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Class="@CssHelper.Build().Medium("pa").Large("mb")" Outlined="true" Style="text-align: center; padding-bottom: 12px !important;">
        <AskReviewComponent ShowOtherApps="false" ActionColor="Color.Default">
            <CustomHeader>
                <MudAlert Variant="Variant.Outlined" Severity="MudBlazor.Severity.Warning" Class="mb-3" Style="text-align: center;">
                    @Translations.Module.Profile.HelpUsUnlock
                </MudAlert>
            </CustomHeader>
        </AskReviewComponent>
    </MudPaper>
}

<PageSectionComponent Title="@Translations.Module.Profile.LatestUsersRegion.CustomFormat(CountryEnum?.GetFieldSettings()?.Name ?? "Unknown")" CustomBodyClass="mb-12">
    <BodyFragment>
        <RenderControl Actions="LastUsersActions" LoadingHeight="130px">
            <Slider List="LastUsers?.Items ?? []" Context="item">
                <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px; position: relative;")">
                    <MudChip T="string" Color="Color.Primary" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1; white-space: break-spaces;" Size="Size.Small">
                        @(item.Nickname ?? "no profile")
                    </MudChip>
                    @if (item.State.NotEmpty())
                    {
                        <MudChip T="string" Color="Color.Tertiary" Label="true" Style="padding: 0.2rem; position: absolute; top: 25px; left: 0; height: auto; z-index: 1; white-space: break-spaces;" Size="Size.Small">
                            @(item.State)
                        </MudChip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Secondary" Variant="Variant.Filled"
                                   Style="position: absolute; bottom: 10px; right: 10px; z-index: 1;" Size="Size.Small" Disabled="@item.Nickname.Empty()"
                                   OnClick="@(async () => await DialogService!.OpenPopupProfile(MM.Shared.Enums.Origin.Highlight, AppStateStatic.UserId, item.Id, null, true))"></MudIconButton>
                    <MudImage Src="images/no-face-photo.webp" Fluid="true" ObjectFit="ObjectFit.Contain" Style="vertical-align: bottom;"></MudImage>
                </div>
            </Slider>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<MudGrid Spacing="@CssHelper.SpaceSmall" Class="@CssHelper.Build().Small("mb")">
    <MudItem xs="12" sm="6" md="4">
        @if ((AppStateStatic.Principal == null || !AppStateStatic.Principal.PublicProfile) && validation == null) //empty or private profile
        {
            <MudPaper Class="pa-3" Outlined="true">
                <MudToolBar WrapContent="true" Dense="true" Gutters="false" Style="min-height: auto;">
                    <MudIcon Icon="@IconsFA.Solid.Icon("circle-user").Font" Class="me-2" Color="Color.Primary" Style="@($"font-size: {imageSize} !important; width: auto;")"></MudIcon>
                    <MudText Typo="Typo.h2" Color="Color.Primary" Style="@($"font-size: {titleFontSize}; line-height: 1.2;")">
                        @Translations.Module.Profile.CompleteYourProfile
                    </MudText>
                </MudToolBar>

                <MudStepper Vertical="true" NonLinear="true" CompletedStepColor="Color.Success" CurrentStepColor="Color.Primary">
                    <ChildContent>
                        <MudStep Title="@Translations.Module.Profile.StepProfile" SecondaryText="@Translations.Module.Profile.StepProfileDesc" Completed="ProfileValid">
                            <MudButton Color="@GetButtonColor(ProfileValid)" StartIcon="@GetButtonIcon(ProfileValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/data")
                                       Style="width: 100%;" Disabled="@(AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile)">
                                @Translations.Button.Profile
                                <MudChip T="string" Label="true" Size="Size.Small" Style="height: auto;" Class="ms-2" Color="Color.Info">
                                    @profile.GetOverallCompletionPercentage().ToString("P0")
                                </MudChip>
                            </MudButton>
                        </MudStep>
                        <MudStep Title="@Translations.Module.Profile.StepFilter" SecondaryText="@Translations.Module.Profile.StepFilterDesc" Completed="FilterValid">
                            <MudButton Color="GetButtonColor(FilterValid)" StartIcon="@GetButtonIcon(FilterValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/filter")
                                       Style="width: 100%;" Disabled="profile == null">
                                @Translations.Button.Filters
                                <MudChip T="string" Label="true" Size="Size.Small" Style="height: auto;" Class="ms-2" Color="Color.Info">
                                    @FilterValidation.GetTotalFilters(filter, null).ToString("N0")
                                </MudChip>
                            </MudButton>
                        </MudStep>
                        <MudStep Title="@Translations.Module.Profile.StepSettings" SecondaryText="@Translations.Module.Profile.StepSettingsDesc" Completed="SettingValid">
                            <MudButton Color="GetButtonColor(SettingValid)" StartIcon="@GetButtonIcon(SettingValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/setting")
                                       Style="width: 100%;" Disabled="profile == null || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile">
                                @Translations.Button.Settings
                            </MudButton>
                        </MudStep>
                        <MudStep Title="@Translations.Module.Profile.StepGallery" SecondaryText="@Translations.Module.Profile.StepGalleryDesc" Completed="GalleryValid">
                            <MudButton Color="GetButtonColor(GalleryValid)" StartIcon="@GetButtonIcon(GalleryValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/gallery")
                                       Style="width: 100%;"
                                       Disabled="profile == null || profile.Gallery?.Type == GalleryType.BlindDate || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile">
                                @Translations.Button.Gallery
                            </MudButton>
                        </MudStep>
                        <MudStep Title="@Translations.Module.Profile.StepValidation" SecondaryText="@Translations.Module.Profile.StepValidationDesc" Completed="ValidationGeral">
                            <MudButton Color="GetButtonColor(ValidationGeral)" StartIcon="@GetButtonIcon(ValidationGeral)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/validation")
                                       Style="width: 100%;" Disabled="profile == null || profile.Gallery?.Type == GalleryType.BlindDate">
                                @Translations.Button.Validations
                            </MudButton>
                        </MudStep>
                    </ChildContent>
                    <ActionContent></ActionContent>
                    <CompletedContent>
                        <MudToggleGroup T="bool" SelectionMode="SelectionMode.SingleSelection" Value="@(AppStateStatic.Principal?.PublicProfile ?? false)" ValueChanged="(bool value) => IsPublicChanged(value)"
                                        FixedContent="true" Disabled="AppStateStatic.Principal == null">
                            <MudToggleItem Value="false" Text="@Translations.Module.Profile.Private" />
                            <MudToggleItem Value="true" Text="@Translations.Module.Profile.Public" />
                        </MudToggleGroup>
                    </CompletedContent>
                </MudStepper>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="@CssHelper.Build().Small("pa")" Outlined="true" Style="text-align: center;">
                <MudAvatar Class="mb-2" Style="width: 50%; height: auto;">
                    <MudImage Src="@(profile?.GetPhoto(ImageHelper.PhotoType.Face, true) ?? ImageHelper.GetFacePhoto)" FallbackSrc="@ImageHelper.GetFacePhoto" Fluid="true" />
                </MudAvatar>
                <div class="mb-2" style="text-align: center;">
                    <MudChip T="string" Color="Color.Primary" Label="true">
                        @(profile?.NickName ?? "NickName")
                    </MudChip>
                    <MudTooltip Text="@profile?.Location">
                        <MudChip T="string" Color="Color.Secondary" Label="true" Icon="@Icons.Material.Filled.Apartment">
                            @(profile?.GetLocation(LocationType.City) ?? "City")
                        </MudChip>
                    </MudTooltip>
                    <MudText Typo="Typo.body1" Align="Align.Justify">
                        @profile?.Description
                    </MudText>
                </div>
                <MudGrid Spacing="@CssHelper.SpaceSmall">
                    <MudItem xs="3">
                        <MudBadge Icon="@GetButtonIcon(ValidationGallery)" Overlap="true" Color="GetButtonColor(ValidationGallery)" Style="width: 100%;">
                            <MudButton StartIcon="@IconsFA.Solid.Icon("images").Font" Variant="Variant.Outlined" Style="width: 100%; cursor: unset;" Class="vertical-button">
                                @Translations.Button.Gallery
                            </MudButton>
                        </MudBadge>
                    </MudItem>
                    <MudItem xs="3">
                        <MudBadge Icon="@GetButtonIcon(ValidationIdentity)" Overlap="true" Color="GetButtonColor(ValidationIdentity)" Style="width: 100%;">
                            <MudButton StartIcon="@IconsFA.Solid.Icon("id-card").Font" Variant="Variant.Outlined" Style="width: 100%; cursor: unset;" Class="vertical-button">
                                @Translations.Button.Identity
                            </MudButton>
                        </MudBadge>
                    </MudItem>
                    <MudItem xs="6">
                        <MudToggleGroup T="bool" SelectionMode="SelectionMode.SingleSelection" Value="@(AppStateStatic.Principal?.PublicProfile ?? false)" ValueChanged="(bool value) => IsPublicChanged(value)"
                                        FixedContent="true" Disabled="AppStateStatic.Principal == null" Style="height: 100%;">
                            <MudToggleItem Value="false" Class="vertical-button">
                                <MudIcon Icon="@IconsFA.Solid.Icon("eye-slash").Font"></MudIcon>
                                @Translations.Module.Profile.Private
                            </MudToggleItem>
                            <MudToggleItem Value="true" Class="vertical-button">
                                <MudIcon Icon="@IconsFA.Solid.Icon("eye").Font"></MudIcon>
                                @Translations.Module.Profile.Public
                            </MudToggleItem>
                        </MudToggleGroup>
                    </MudItem>
                    @* <MudItem xs="3">
                        <MudBadge Icon="@GetButtonIcon(ValidationNetWorth)" Overlap="true" Color="GetButtonColor(ValidationNetWorth)" Style="width: 100%;">
                            <MudButton StartIcon="@IconsFA.Solid.Icon("gem").Font" Variant="Variant.Outlined" Style="width: 100%;" Class="vertical-button"
                                       OnClick="@(()=>ShowInfo(GlobalTranslations.FeatureNotAvailable.Format(3)))">
                                Wealth
                            </MudButton>
                        </MudBadge>
                    </MudItem> *@
                    @*  <MudItem xs="3">
                        <MudBadge Icon="@GetButtonIcon(ValidationAnnualIncome)" Overlap="true" Color="GetButtonColor(ValidationAnnualIncome)" Style="width: 100%;">
                            <MudButton StartIcon="@IconsFA.Solid.Icon("money-bill").Font" Variant="Variant.Outlined" Style="width: 100%;" Class="vertical-button"
                                       OnClick="@(()=>ShowInfo(GlobalTranslations.FeatureNotAvailable.Format(3)))">
                                Income
                            </MudButton>
                        </MudBadge>
                    </MudItem> *@
                    <MudItem xs="6">
                        <MudButton Color="@GetButtonColor(ProfileValid)" StartIcon="@GetButtonIcon(ProfileValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/data")
                                   Style="width: 100%;" Disabled="@(AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile)">
                            @Translations.Button.Profile
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="GetButtonColor(FilterValid)" StartIcon="@GetButtonIcon(FilterValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/filter")
                                   Style="width: 100%;" Disabled="profile == null">
                            @Translations.Button.Filters
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="GetButtonColor(SettingValid)" StartIcon="@GetButtonIcon(SettingValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/setting")
                                   Style="width: 100%;" Disabled="profile == null || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile">
                            @Translations.Button.Settings
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="GetButtonColor(GalleryValid)" StartIcon="@GetButtonIcon(GalleryValid)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/gallery")
                                   Style="width: 100%;" Disabled="profile == null || profile.Gallery?.Type == GalleryType.BlindDate || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile">
                            @Translations.Button.Gallery
                        </MudButton>
                    </MudItem>
                    <MudItem xs="6">
                        <MudButton Color="GetButtonColor(ValidationGeral)" StartIcon="@GetButtonIcon(ValidationGeral)" Variant="Variant.Filled" Href=@($"/{Culture}/profile/validation")
                                   Style="width: 100%;" Disabled="profile == null || profile.Gallery?.Type == GalleryType.BlindDate">
                            @Translations.Button.Validations
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudItem>
    <MudItem xs="12" sm="6" md="8">
        <PageSectionComponent Icon="@IconsFA.Solid.Icon("thumbs-up").Font" Title="@Translations.Module.Profile.Suggestions">
            <ActionsFragment>
                <MudTooltip Text="Generate new suggestion list">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GenerateSuggestions" Disabled="!AppStateStatic.IsAuthenticated">
                        @Translations.Button.Generate
                    </MudButton>
                </MudTooltip>
            </ActionsFragment>
            <BodyFragment>
                <RenderControl Actions="SuggestionsActions" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated" PremiumFeature="true" IsPremium="AppStateStatic.IsPremiumUser" LoadingHeight="130px">
                    <Slider List="Suggestions" Context="item">
                        <FeatureUnavailable></FeatureUnavailable>
                    </Slider>
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>
        <PageSectionComponent Icon="@IconsFA.Solid.Icon("heart-circle-exclamation").Font" Title="@Translations.Module.Profile.Likes">
            <BodyFragment>
                <RenderControl Actions="LikesActions" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated" LoadingHeight="130px">
                    <Slider List="MyLikes?.Items ?? []" Context="item">
                        <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px; position: relative; cursor: pointer;")"
                             @onclick="@(async () => await DialogService!.OpenPopupProfile(MM.Shared.Enums.Origin.Like, AppStateStatic.UserId, item.UserId))">
                            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;" Size="AppStateStatic.Size">
                                @item.UserName
                            </MudChip>
                            <MudImage Src="@item.GetUserPhoto()" FallbackSrc="images/no-face-photo.webp" Alt="@item.UserName"
                                      Fluid="true" ObjectFit="ObjectFit.Contain" Style="vertical-align: bottom;"></MudImage>
                        </div>
                    </Slider>
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>
        <PageSectionComponent Icon="@IconsFA.Solid.Icon("heart-circle-check").Font" Title="@Translations.Module.Profile.Matches" ShowActions="MyMatches == null || MyMatches.Items.Empty()">
            <ActionsFragment>
                @if (MyMatches == null || MyMatches.Items.Empty())
                {
                    <MudTooltip Text="Simulate matches to learn about our compatibility system">
                        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SimulateMatches" Disabled="!AppStateStatic.IsAuthenticated">
                            @Translations.Button.Simulate
                        </MudButton>
                    </MudTooltip>
                }
            </ActionsFragment>
            <BodyFragment>
                <RenderControl Actions="MatchesActions" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated" LoadingHeight="130px">
                    <Slider List="MyMatches?.Items ?? []" Context="item">
                        <div style="@($"width: {(AppStateStatic.IsMobile ? "110" : "130")}px; position: relative;")">
                            <MudChip T="string" Color="Color.Info" Label="true" Style="padding: 0.2rem; position: absolute; top: 0; left: 0; height: auto; z-index: 1;" Size="AppStateStatic.Size">
                                @item.UserName
                            </MudChip>
                            <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Color="Color.Secondary" Variant="Variant.Filled"
                                           Style="position: absolute; bottom: 10px; right: 10px; z-index: 1;" Size="Size.Small"
                                           OnClick="@(async () => await DialogService!.OpenPopupProfile(MM.Shared.Enums.Origin.Match, AppStateStatic.UserId, item.UserId, fakeProfiles.SingleOrDefault(s => s.Id == item.UserId)))"></MudIconButton>
                            <MudImage Src="@item.GetUserPhoto()" FallbackSrc="images/no-face-photo.webp" Alt="@item.UserName"
                                      Fluid="true" ObjectFit="ObjectFit.Contain" Style="vertical-align: bottom;"></MudImage>
                        </div>
                    </Slider>
                </RenderControl>
            </BodyFragment>
        </PageSectionComponent>
    </MudItem>
</MudGrid>

<style>
    .mud-stepper .mud-stepper-nav.mud-stepper-nav-scrollable .mud-step {
        width: 100%;
    }

    .mud-stepper .mud-stepper-nav .mud-step .mud-step-label {
        width: 100%;
    }
</style>

@code
{
    private ComponentActions<LastRegionUsersCache> LastUsersActions { get; } = new(obj => obj?.Data == null || obj.Data.Items.Empty());
    public LastRegionUsers? LastUsers { get; set; }
    private Country? CountryEnum;

    private ProfileValidation ProfileValidator { get; } = new();
    private ProfileModel? profile;

    private HashSet<ProfileModel> fakeProfiles { get; set; } = [];
    private ComponentActions<ProfileModel> ProfileActions { get; } = new(obj => obj == null);

    private FilterValidation FilterValidator { get; } = new();
    private FilterModel? filter;
    private ComponentActions<FilterModel> FilterActions { get; } = new(obj => obj == null);

    private PhotoValidation PhotoValidator { get; } = new();

    private SettingModel? setting;
    private ComponentActions<SettingModel> SettingActions { get; } = new(obj => obj == null);

    private ValidationModel? validation;

    private List<string> Suggestions { get; } = [];
    private ComponentActions<List<string>> SuggestionsActions { get; } = new(lst => lst == null || lst.Empty());

    private MyLikesModel? MyLikes { get; set; }
    private ComponentActions<MyLikesModel> LikesActions { get; } = new(obj => obj == null || obj.Items.Empty());

    private MyMatchesModel? MyMatches { get; set; }
    private ComponentActions<MyMatchesModel> MatchesActions { get; } = new(obj => obj == null || obj.Items.Empty());

    private string imageSize => AppStateStatic.Size == Size.Small ? "20px" : "24px";
    private string titleFontSize => AppStateStatic.Size == Size.Small ? "20px" : "24px";

    private bool ProfileValid => profile != null && ProfileValidator.Validate(profile, options => options.IncludeAllRuleSets()).IsValid;
    private bool FilterValid => filter != null && FilterValidator.Validate(filter).IsValid;
    private bool SettingValid => setting != null;
    private bool GalleryValid => profile?.Gallery != null && PhotoValidator.Validate(profile.Gallery).IsValid;
    private bool ValidationGeral => validation != null && validation.Gallery; //todo: implement the others when available
    private bool ValidationGallery => validation != null && validation.Gallery;
    private bool ValidationIdentity => validation != null && validation.Kyc;
    private bool ValidationNetWorth => validation != null && validation.NetWorth;
    private bool ValidationAnnualIncome => validation != null && validation.AnnualIncome;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ProfileApi.DataChanged += model =>
        {
            profile = model;
            StateHasChanged();
        };

        SuggestionsActions.CustomPremiumDescription = Translations.Module.Profile.FeatureNotAvailable.CustomFormat(2);
    }

    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (AppStateStatic.IsAuthenticated)
    //     {
    //         var subscription = await GetLocalStorage("subscription-popup");

    //         if (subscription.Empty())
    //         {
    //             await DialogService.SubscriptionPopup(AppStateStatic.IsAuthenticated);
    //             await SetLocalStorage("subscription-popup", true.ToString().ToLower());
    //         }
    //     }

    //     await base.OnAfterRenderAsync(firstRender);
    // }

    protected override async Task<bool> LoadInteropDataAsync(IJSRuntime JsRuntime)
    {
        var countryStr = await AppStateStatic.GetCountry(IpInfoApi, JsRuntime, Cts.Token);

        if (countryStr.NotEmpty())
        {
            CountryEnum = EnumHelper.ParseToEnum<Country>(countryStr);

            var cache2 = await LastRegionUsersApi.LastRegionUsers("compact", countryStr, LastUsersActions, Cts.Token);
            LastUsers = cache2?.Data;
        }

        if (countryStr.NotEmpty() && (LastUsers?.Items.Empty() ?? true))
        {
            if (AppStateStatic.IsAuthenticated)
                await LastUsersActions.ShowWarning(Translations.Module.Profile.NoUsersYetOn);
            else
                await LastUsersActions.ShowWarning(Translations.Module.Profile.NoUsersYetOff);
        }

        return true;
    }

    protected override async Task LoadAuthenticatedDataAsync(CancellationToken token)
    {
        profile = await ProfileApi.Get(ProfileActions, token);
        filter = await FilterApi.Get(FilterActions, token);
        setting = await SettingApi.Get(SettingActions, token);
        validation = await ValidationApi.Get(token);

        //remove the loading status
        await SuggestionsActions.StartLoading.Invoke(null);
        await SuggestionsActions.FinishLoading.Invoke(null);

        MyLikes = await MyLikesApi.Get(false, LikesActions, token);
        MyMatches = await MyMatchesApi.Get(false, MatchesActions, token);
    }

    private Color GetButtonColor(bool valid)
    {
        return valid ? Color.Success : Color.Warning;
    }

    private string? GetButtonIcon(bool valid)
    {
        return valid ? IconsFA.Solid.Icon("check").Font : IconsFA.Solid.Icon("circle-question").Font;
    }

    private async Task IsPublicChanged(bool value)
    {
        try
        {
            if (value)
            {
                if (!ProfileValid || !FilterValid || !SettingValid || !GalleryValid || !ValidationGeral)
                {
                    await ShowWarning(Translations.Module.Profile.CompleteAllSteps);
                }
                else
                {
                    await PrincipalApi.Public(Cts.Token);
                    await ShowSuccess(Translations.Module.Profile.ProfilePublicMode);
                }
            }
            else
            {
                await PrincipalApi.Private(Cts.Token);
                await ShowSuccess(Translations.Module.Profile.ProfilePrivateMode);
            }
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }

    private async Task GenerateSuggestions()
    {
        await ShowWarning(Translations.Module.Profile.FeatureNotAvailable.CustomFormat(2));
    }

    private async Task SimulateMatches()
    {
        if (profile == null)
        {
            await ShowWarning("You need to complete your profile first. (Step 1)");
            return;
        }

        if (filter == null)
        {
            await ShowWarning("You need to define your filters first. (Step 2)");
            return;
        }

        if (await DialogService.ShowMessageBoxAsync(Translations.Notification.Confirmation, Translations.Module.Profile.GenerateSimulation, Translations.Button.Ok, Translations.Button.Cancel) ?? false)
        {
            MyMatches = new MyMatchesModel(AppStateStatic.UserId);
            await MatchesActions.StartLoading.Invoke(null);

            var languages = EnumHelper.GetValues<Language>();

            fakeProfiles = new Faker<ProfileModel>()
                .CustomInstantiator(f => new ProfileModel(f.Random.Guid().ToString()))
                .RuleFor(u => u.Gallery, f => new ProfileGalleryModel { FaceId = $"https://api.dicebear.com/9.x/avataaars/svg?size=300&seed=example={f.Random.Guid().ToString()}" })
                //BASIC
                .RuleFor(x => x.NickName, f => f.Name.FirstName())
                .RuleFor(x => x.Description, f => f.Lorem.Text())
                .RuleFor(x => x.Nationality, f => f.PickRandom<Country>())
                .RuleFor(x => x.Country, f => f.Address.Country())
                .RuleFor(x => x.State, f => f.Address.County())
                .RuleFor(x => x.City, f => f.Address.City())
                .RuleFor(x => x.Languages, f => f.Random.EnumValues<Language>(f.Random.Int(1, 3)).ToHashSet())
                .RuleFor(x => x.MaritalStatus, f => f.PickRandom<MaritalStatus>())
                .RuleFor(x => x.BiologicalSex, f => f.PickRandom<BiologicalSex>())
                .RuleFor(x => x.GenderIdentities, f => f.Random.EnumValues<GenderIdentity>(f.Random.Int(1, 2)).ToHashSet())
                .RuleFor(x => x.SexualOrientations, f => f.Random.EnumValues<SexualOrientation>(f.Random.Int(1, 2)).ToHashSet())
                //BIO
                .RuleFor(x => x.Ethnicity, f => f.PickRandom<Ethnicity>())
                .RuleFor(x => x.BodyType, f => f.PickRandom<BodyType>())
                .RuleFor(x => x.BirthDate, f => f.Date.Between(DateTime.Now.AddYears(-80), DateTime.Now.AddYears(-19)))
                .RuleFor(x => x.Age, f => f.Random.Int(18, 80))
                .RuleFor(x => x.Height, f => f.PickRandom<Height>())
                .RuleFor(x => x.Neurodiversity, f => f.PickRandom<Neurodiversity>())
                .RuleFor(x => x.Disabilities, f => f.Random.EnumValues<Disability>(f.Random.Int(0, 1)).ToHashSet())
                //LIFESTYLE
                .RuleFor(x => x.Drink, f => f.PickRandom<Drink>())
                .RuleFor(x => x.Smoke, f => f.PickRandom<Smoke>())
                .RuleFor(x => x.Diet, f => f.PickRandom<Diet>())
                .RuleFor(x => x.Religion, f => f.PickRandom<Religion>())
                .RuleFor(x => x.FamilyInvolvement, f => f.PickRandom<FamilyInvolvement>())
                .RuleFor(x => x.HaveChildren, f => f.PickRandom<HaveChildren>())
                .RuleFor(x => x.HavePets, f => f.PickRandom<HavePets>())
                .RuleFor(x => x.EducationLevel, f => f.PickRandom<EducationLevel>())
                .RuleFor(x => x.CareerCluster, f => f.PickRandom<CareerCluster>())
                .RuleFor(x => x.LivingSituation, f => f.PickRandom<LivingSituation>())
                .RuleFor(x => x.TravelFrequency, f => f.PickRandom<TravelFrequency>())
                .RuleFor(x => x.NetWorth, f => f.PickRandom<NetWorth>())
                .RuleFor(x => x.AnnualIncome, f => f.PickRandom<AnnualIncome>())
                //PERSONALITY
                .RuleFor(x => x.MoneyPersonality, f => f.PickRandom<MoneyPersonality>())
                .RuleFor(x => x.SharedSpendingStyle, f => f.PickRandom<SharedSpendingStyle>())
                .RuleFor(x => x.RelationshipPersonality, f => f.PickRandom<RelationshipPersonality>())
                .RuleFor(x => x.MBTI, f => f.PickRandom<MyersBriggsTypeIndicator>())
                .RuleFor(x => x.LoveLanguage, f => f.PickRandom<LoveLanguage>())
                .RuleFor(x => x.SexPersonality, f => f.PickRandom<SexPersonality>())
                .RuleFor(x => x.SexPersonalityPreference, f => f.Random.EnumValues<SexPersonality>(f.Random.Int(1, 3)).ToHashSet())
                //INTEREST
                .RuleFor(x => x.Food, f => f.Random.EnumValues<Food>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.Vacation, f => f.Random.EnumValues<Vacation>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.Sports, f => f.Random.EnumValues<Sports>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.LeisureActivities, f => f.Random.EnumValues<LeisureActivities>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.MusicGenre, f => f.Random.EnumValues<MusicGenre>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.MovieGenre, f => f.Random.EnumValues<MovieGenre>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.TVGenre, f => f.Random.EnumValues<TVGenre>(f.Random.Int(0, 3)).ToHashSet())
                .RuleFor(x => x.ReadingGenre, f => f.Random.EnumValues<ReadingGenre>(f.Random.Int(0, 3)).ToHashSet())
                //RELATIONSHIP
                .RuleFor(x => x.SharedFinances, f => f.PickRandom<SharedFinances>())
                .RuleFor(x => x.ConflictResolutionStyle, f => f.PickRandom<ConflictResolutionStyle>())
                .RuleFor(x => x.HouseholdManagement, f => f.PickRandom<HouseholdManagement>())
                .RuleFor(x => x.TimeTogetherPreference, f => f.PickRandom<TimeTogetherPreference>())
                .RuleFor(x => x.OppositeSexFriendships, f => f.PickRandom<OppositeSexFriendships>())
                //GOAL
                .RuleFor(x => x.RelationshipIntentions, f => f.Random.EnumValues<RelationshipIntention>(f.Random.Int(1, 2)).ToHashSet())
                .RuleFor(x => x.WantChildren, f => f.PickRandom<WantChildren>())
                .RuleFor(x => x.Relocation, f => f.PickRandom<Relocation>())
                .RuleFor(x => x.IdealPlaceToLive, f => f.PickRandom<IdealPlaceToLive>())
                .GenerateLazy(8).ToHashSet();

            MyMatches.Items = fakeProfiles.Select(s => new PersonModel { UserId = s.Id, UserName = s.NickName, UserPhoto = s.Gallery?.FaceId, Fake = true }).ToList();

            await MatchesActions.FinishLoading.Invoke(MyMatches);
        }
    }

    private async Task Login()
    {
        Navigation.NavigateTo($"/{Culture}/auth/login?returnUrl={Uri.EscapeDataString(Navigation.Uri.Split('#')[0])}");
    }

