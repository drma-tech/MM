@page "/{culture}/profile/data"
@attribute [Authorize]

@using BiologicalSex = MM.Shared.Enums.BiologicalSex
@using CareerCluster = MM.Shared.Enums.CareerCluster
@using Diet = MM.Shared.Enums.Diet
@using Disability = MM.Shared.Enums.Disability
@using Drink = MM.Shared.Enums.Drink
@using FluentValidation
@using HaveChildren = MM.Shared.Enums.HaveChildren
@using Height = MM.Shared.Enums.Height
@using LoveLanguage = MM.Shared.Enums.LoveLanguage
@using MM.Shared.Models.Profile
@using MM.Shared.Translations.Model
@using Microsoft.AspNetCore.Authorization
@using MoneyPersonality = MM.Shared.Enums.MoneyPersonality
@using MyersBriggsTypeIndicator = MM.Shared.Enums.MyersBriggsTypeIndicator
@using Neurodiversity = MM.Shared.Enums.Neurodiversity
@using RelationshipPersonality = MM.Shared.Enums.RelationshipPersonality
@using SexPersonality = MM.Shared.Enums.SexPersonality
@using SharedSpendingStyle = MM.Shared.Enums.SharedSpendingStyle
@using Smoke = MM.Shared.Enums.Smoke
@using TravelFrequency = MM.Shared.Enums.TravelFrequency
@using WantChildren = MM.Shared.Enums.WantChildren
@using static MM.Shared.Core.Helper.ProfileHelper

@inherits PageCore<ProfileDataPage>

<HeadComponent Title="@Translations.Title.Profile" Url=@($"/{Culture}/profile/data") Index="false"></HeadComponent>

<CustomNavigationLock IsDirty="IsDirty"></CustomNavigationLock>

<RenderControl T="ProfileModel" State="State" PrivateFeature="true" IsAuthenticated="AppStateStatic.IsAuthenticated" LoadingHeight="400px" Class="@CssHelper.Build().Small("mb")" Context="profile">
    <MudForm @ref="_form" FieldChanged="OnFieldChanged" Class="mb-3">
        <MudExpansionPanels Elevation="2">
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.BASIC))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Basic</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.BASIC).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldText Name="@ProfileBasicModel.NickName_Name" Placeholder="@ProfileBasicModel.NickName_Placeholder"
                                           @bind-Value="@profile.NickName" CssIcon="@IconsFA.Solid.Icon("user").Font" Required="true"></FieldText>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldText Name="@ProfileBasicModel.Description_Name" Placeholder="@ProfileBasicModel.Description_Placeholder"
                                           @bind-Value="@profile.Description" CssIcon="@IconsFA.Solid.Icon("quote-left").Font" Rows="8">
                                </FieldText>
                            </MudItem>
                            <MudItem xs="12">
                                <Country Name="@ProfileBasicModel.Nationality_Name" SelectedValue="@profile.Nationality" SelectedValueChanged="CountryChanged"
                                         CssIcon="@IconsFA.Solid.Icon("earth-americas").Font" Required="true">
                                </Country>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBasicModel.Languages_Name" Description="@ProfileBasicModel.Languages_Description"
                                             TValue="HashSet<Language>" TEnum="Language" @bind-SelectedValues="@profile.Languages"
                                             CssIcon="@IconsFA.Solid.Icon("language").Font" Required="true" Multiple="true" Order="@(o => o.Name)" ShowDataSelectDescription="false"
                                             CustomWarning="@(profile.Languages.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldText Name="@ProfileBasicModel.Location_Name" Description="@ProfileBasicModel.Location_Description" Placeholder="@ProfileBasicModel.Location_Placeholder"
                                           Value="@profile.Location" CssIcon="@IconsFA.Solid.Icon("location-dot").Font" Required="true" ReadOnly="true"
                                           ButtomClicked="async () => { await SetLocation(profile); }" ButtomCssIcon="@IconsFA.Solid.Icon("map-location-dot").Font"
                                           ButtomTitle="@Translations.Button.RetrieveGPSPosition">
                                </FieldText>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBasicModel.MaritalStatus_Name"
                                             TValue="MaritalStatus?" TEnum="MaritalStatus" @bind-SelectedValue="@profile.MaritalStatus"
                                             CssIcon="@IconsFA.Solid.Icon("ring").Font" Required="true">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBasicModel.BiologicalSex_Name"
                                             TValue="BiologicalSex?" TEnum="BiologicalSex" @bind-SelectedValue="@profile.BiologicalSex"
                                             CssIcon="@IconsFA.Solid.Icon("person-half-dress").Font" Required="true">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBasicModel.GenderIdentity_Name" Description="@ProfileBasicModel.GenderIdentity_Description"
                                             TValue="HashSet<GenderIdentity>" TEnum="GenderIdentity" @bind-SelectedValues="@profile.GenderIdentities"
                                             CssIcon="@IconsFA.Solid.Icon("mars-and-venus").Font" Required="true" Multiple="true"
                                             CustomWarning="@(profile.GenderIdentities.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBasicModel.SexualOrientation_Name" Description="@ProfileBasicModel.SexualOrientation_Description"
                                             TValue="HashSet<SexualOrientation>" TEnum="SexualOrientation" @bind-SelectedValues="@profile.SexualOrientations"
                                             CssIcon="@IconsFA.Solid.Icon("heart-pulse").Font" Required="true" Multiple="true"
                                             CustomWarning="@(profile.SexualOrientations.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.BIO))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Bio</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.BIO).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudAlert Dense="true" Variant="Variant.Outlined" Severity="MudBlazor.Severity.Info" Class="mb-4">
                        @Translations.Module.Profile.ProfileDataBioTip1
                    </MudAlert>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs" Class="mb-4">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBioModel.Ethnicity_Name" TValue="Ethnicity?" TEnum="Ethnicity" @bind-SelectedValue="@profile.Ethnicity"
                                             CssIcon="@IconsFA.Solid.Icon("globe").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBioModel.BodyType_Name" TValue="BodyType?" TEnum="BodyType" @bind-SelectedValue="@profile.BodyType"
                                             CssIcon="@IconsFA.Solid.Icon("weight-scale").Font" ShowHelper="false">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <Birthdate Name="@ProfileBioModel.BirthDate_Name" @bind-Value="@profile.BirthDate"
                                           CssIcon="@IconsFA.Solid.Icon("cake-candles").Font">
                                </Birthdate>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileBioModel.Height_Name" TValue="Height?" TEnum="Height" @bind-SelectedValue="@profile.Height"
                                             CssIcon="@IconsFA.Solid.Icon("ruler").Font" ShowHelper="false">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="@(() => { _BioExpanded = !_BioExpanded; })"
                                   EndIcon="@IconsFA.Solid.Icon("arrow-down").Font">
                            @Translations.Module.Profile.OptionalSection
                        </MudButton>
                        <MudCollapse Expanded="_BioExpanded">
                            <MudAlert Dense="true" Variant="Variant.Outlined" Severity="MudBlazor.Severity.Info" Class="my-4">
                                @Translations.Module.Profile.ProfileDataBioTip2
                            </MudAlert>
                            <MudGrid Spacing="@CssHelper.SpaceSmall">
                                <MudItem xs="12" sm="6">
                                    <FieldSelect Name="@ProfileBioModel.Neurodiversity_Name" TValue="Neurodiversity?" TEnum="Neurodiversity" @bind-SelectedValue="@profile.Neurodiversity"
                                                 CssIcon="@IconsFA.Solid.Icon("brain").Font">
                                    </FieldSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <FieldSelect Name="@ProfileBioModel.Disabilities_Name" TValue="HashSet<Disability>" TEnum="Disability" @bind-SelectedValues="@profile.Disabilities"
                                                 CssIcon="@IconsFA.Solid.Icon("wheelchair").Font" Multiple="true">
                                    </FieldSelect>
                                </MudItem>
                            </MudGrid>
                        </MudCollapse>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.LIFESTYLE))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Lifestyle</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.LIFESTYLE).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs" Class="mb-4">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.Drink_Name" TValue="Drink?" TEnum="Drink" @bind-SelectedValue="@profile.Drink"
                                             CssIcon="@IconsFA.Solid.Icon("champagne-glasses").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.Smoke_Name" TValue="Smoke?" TEnum="Smoke" @bind-SelectedValue="@profile.Smoke"
                                             CssIcon="@IconsFA.Solid.Icon("smoking").Font" ShowHelper="false">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.Diet_Name" Description="@ProfileLifestyleModel.Diet_Description" TValue="Diet?" TEnum="Diet" @bind-SelectedValue="@profile.Diet"
                                             CssIcon="@IconsFA.Solid.Icon("utensils").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.Religion_Name" TValue="Religion?" TEnum="Religion" @bind-SelectedValue="@profile.Religion"
                                             CssIcon="@IconsFA.Solid.Icon("hands-praying").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.FamilyInvolvement_Name" Description="@ProfileLifestyleModel.FamilyInvolvement_Description" TValue="FamilyInvolvement?" TEnum="FamilyInvolvement" @bind-SelectedValue="@profile.FamilyInvolvement"
                                             CssIcon="@IconsFA.Solid.Icon("people-roof").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.HaveChildren_Name" TValue="HaveChildren?" TEnum="HaveChildren" @bind-SelectedValue="@profile.HaveChildren"
                                             CssIcon="@IconsFA.Solid.Icon("child").Font" ShowHelper="false">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.HavePets_Name" TValue="HavePets?" TEnum="HavePets" @bind-SelectedValue="@profile.HavePets"
                                             CssIcon="@IconsFA.Solid.Icon("paw").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.EducationLevel_Name" TValue="EducationLevel?" TEnum="EducationLevel" @bind-SelectedValue="@profile.EducationLevel"
                                             CssIcon="@IconsFA.Solid.Icon("graduation-cap").Font" ShowHelper="true">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.CareerCluster_Name" TValue="CareerCluster?" TEnum="CareerCluster" @bind-SelectedValue="@profile.CareerCluster"
                                             CssIcon="@IconsFA.Solid.Icon("briefcase").Font" ShowGroup="true">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.LivingSituation_Name" TValue="LivingSituation?" TEnum="LivingSituation" @bind-SelectedValue="@profile.LivingSituation"
                                             CssIcon="@IconsFA.Solid.Icon("house-user").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileLifestyleModel.TravelFrequency_Name" TValue="TravelFrequency?" TEnum="TravelFrequency" @bind-SelectedValue="@profile.TravelFrequency"
                                             CssIcon="@IconsFA.Solid.Icon("plane").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="@(() => { _LifeExpanded = !_LifeExpanded; })"
                                   EndIcon="@IconsFA.Solid.Icon("arrow-down").Font">
                            @Translations.Module.Profile.OptionalSection
                        </MudButton>
                        <MudCollapse Expanded="_LifeExpanded">
                            <MudAlert Dense="true" Variant="Variant.Outlined" Severity="MudBlazor.Severity.Info" Class="my-4">
                                Due to the sensitive nature of this information, it will only be visible to candidates after the match is made.
                            </MudAlert>
                            <MudGrid Spacing="@CssHelper.SpaceSmall">
                                <MudItem xs="12" sm="6">
                                    <FieldSelect Name="@ProfileLifestyleModel.NetWorth_Name" Description="@ProfileLifestyleModel.NetWorth_Description" TValue="NetWorth?" TEnum="NetWorth" @bind-SelectedValue="@profile.NetWorth"
                                                 CssIcon="@IconsFA.Solid.Icon("gem").Font" ShowHelper="false"
                                                 ButtomTitle="Check" ButtomCssIcon="@Icons.Material.Filled.CheckCircle" ButtomDisabled="true">
                                    </FieldSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <FieldSelect Name="@ProfileLifestyleModel.AnnualIncome_Name" Description="@ProfileLifestyleModel.AnnualIncome_Description" TValue="AnnualIncome?" TEnum="AnnualIncome" @bind-SelectedValue="@profile.AnnualIncome"
                                                 CssIcon="@IconsFA.Solid.Icon("money-bill").Font" ShowHelper="false"
                                                 ButtomTitle="Check" ButtomCssIcon="@Icons.Material.Filled.CheckCircle" ButtomDisabled="true">
                                    </FieldSelect>
                                </MudItem>
                            </MudGrid>
                        </MudCollapse>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.PERSONALITY))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Personality</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.PERSONALITY).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudAlert Dense="true" Variant="Variant.Outlined" Severity="MudBlazor.Severity.Info" Class="mb-4">
                        @Translations.Module.Profile.ProfileDataPersonTip1
                    </MudAlert>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.MoneyPersonality_Name" Description="@ProfilePersonalityModel.MoneyPersonality_Description" TValue="MoneyPersonality?" TEnum="MoneyPersonality" @bind-SelectedValue="@profile.MoneyPersonality"
                                             CssIcon="@IconsFA.Solid.Icon("wallet").Font" HelpLink="https://moneytype.hermoney.com/">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.SharedSpendingStyle_Name" TValue="SharedSpendingStyle?" TEnum="SharedSpendingStyle" @bind-SelectedValue="@profile.SharedSpendingStyle"
                                             CssIcon="@IconsFA.Solid.Icon("hand-holding-dollar").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.RelationshipPersonality_Name" Description="@ProfilePersonalityModel.RelationshipPersonality_Description" TValue="RelationshipPersonality?" TEnum="RelationshipPersonality" @bind-SelectedValue="@profile.RelationshipPersonality"
                                             CssIcon="@IconsFA.Solid.Icon("people-pulling").Font" HelpLink="https://theanatomyoflove.com/relationship-quizzes/helen-fishers-personality-test/">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.MBTI_Name" Description="@ProfilePersonalityModel.MBTI_Description" TValue="MyersBriggsTypeIndicator?" TEnum="MyersBriggsTypeIndicator" @bind-SelectedValue="@profile.MBTI"
                                             CssIcon="@IconsFA.Solid.Icon("user-tag").Font" HelpLink="https://www.16personalities.com/" ShowGroup="true">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.LoveLanguage_Name" Description="@ProfilePersonalityModel.LoveLanguage_Description" TValue="LoveLanguage?" TEnum="LoveLanguage" @bind-SelectedValue="@profile.LoveLanguage"
                                             CssIcon="@IconsFA.Solid.Icon("hand-holding-heart").Font" HelpLink="https://5lovelanguages.com/quizzes/love-language">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.SexPersonality_Name" Description="@ProfilePersonalityModel.SexPersonality_Description" TValue="SexPersonality?" TEnum="SexPersonality" @bind-SelectedValue="@profile.SexPersonality"
                                             CssIcon="@IconsFA.Solid.Icon("heart").Font" HelpLink="https://vmtherapy.com/sex-personality-type">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfilePersonalityModel.SexPersonalityPreferences_Name" Description="@ProfilePersonalityModel.SexPersonalityPreferences_Description" TValue="HashSet<SexPersonality>" TEnum="SexPersonality" @bind-SelectedValues="@profile.SexPersonalityPreference"
                                             CssIcon="@IconsFA.Solid.Icon("heart-circle-check").Font" Multiple="true"
                                             CustomWarning="@(profile.SexPersonalityPreference.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.INTEREST))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Interest</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.INTEREST).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudAlert Dense="true" Variant="Variant.Outlined" Severity="MudBlazor.Severity.Info" Class="mb-4">
                        @Translations.Module.Profile.Maximum3Items
                    </MudAlert>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.Food" TValue="HashSet<Food>" TEnum="Food" @bind-SelectedValues="@profile.Food"
                                             CssIcon="@IconsFA.Solid.Icon("pizza-slice").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.Food.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.Vacation" TValue="HashSet<Vacation>" TEnum="Vacation" @bind-SelectedValues="@profile.Vacation"
                                             CssIcon="@IconsFA.Solid.Icon("plane-departure").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.Vacation.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.Sports" TValue="HashSet<Sports>" TEnum="Sports" @bind-SelectedValues="@profile.Sports"
                                             CssIcon="@IconsFA.Solid.Icon("person-swimming").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.Sports.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.LeisureActivities" TValue="HashSet<LeisureActivities>" TEnum="LeisureActivities" @bind-SelectedValues="@profile.LeisureActivities"
                                             CssIcon="@IconsFA.Solid.Icon("umbrella-beach").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.LeisureActivities.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.MusicGenre" TValue="HashSet<MusicGenre>" TEnum="MusicGenre" @bind-SelectedValues="@profile.MusicGenre"
                                             CssIcon="@IconsFA.Solid.Icon("music").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.MusicGenre.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.MovieGenre" TValue="HashSet<MovieGenre>" TEnum="MovieGenre" @bind-SelectedValues="@profile.MovieGenre"
                                             CssIcon="@IconsFA.Solid.Icon("film").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.MovieGenre.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.TVGenre" TValue="HashSet<TVGenre>" TEnum="TVGenre" @bind-SelectedValues="@profile.TVGenre"
                                             CssIcon="@IconsFA.Solid.Icon("tv").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.TVGenre.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileInterestModel.ReadingGenre" TValue="HashSet<ReadingGenre>" TEnum="ReadingGenre" @bind-SelectedValues="@profile.ReadingGenre"
                                             CssIcon="@IconsFA.Solid.Icon("book-open-reader").Font" Multiple="true" Order="o => o.Name"
                                             CustomWarning="@(profile.ReadingGenre.Count > 3 ? Translations.Module.Profile.YouHaveSelected.CustomFormat(3) : null)">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.RELATIONSHIP))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Relationship</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.RELATIONSHIP).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileRelationshipModel.SharedFinances" TValue="SharedFinances?" TEnum="SharedFinances" @bind-SelectedValue="@profile.SharedFinances"
                                             CssIcon="@IconsFA.Solid.Icon("money-bill-transfer").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileRelationshipModel.ConflictResolutionStyle" TValue="ConflictResolutionStyle?" TEnum="ConflictResolutionStyle" @bind-SelectedValue="@profile.ConflictResolutionStyle"
                                             CssIcon="@IconsFA.Solid.Icon("handshake").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileRelationshipModel.HouseholdManagement" TValue="HouseholdManagement?" TEnum="HouseholdManagement" @bind-SelectedValue="@profile.HouseholdManagement"
                                             CssIcon="@IconsFA.Solid.Icon("broom").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileRelationshipModel.TimeTogetherPreference" TValue="TimeTogetherPreference?" TEnum="TimeTogetherPreference" @bind-SelectedValue="@profile.TimeTogetherPreference"
                                             CssIcon="@IconsFA.Solid.Icon("hand-holding-hand").Font">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileRelationshipModel.OppositeSexFriendships" Description="@ProfileRelationshipModel.OppositeSexFriendships_Description" TValue="OppositeSexFriendships?" TEnum="OppositeSexFriendships" @bind-SelectedValue="@profile.OppositeSexFriendships"
                                             CssIcon="@IconsFA.Solid.Icon("people-arrows").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
            <MudExpansionPanel HeaderClass="mud-primary-text">
                <TitleContent>
                    <div class="d-flex">
                        @if (profile.IsValid(Tabs.GOAL))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" class="me-3"></MudIcon>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" class="me-3"></MudIcon>
                        }
                        <MudText Color="Color.Primary" Typo="Typo.button" class="me-3">@Section.Goals</MudText>
                        <MudChip T="string" Size="Size.Small" Label="true" Style="height: auto;">@profile.GetCompletionPercentage(Tabs.GOAL).ToString("P0")</MudChip>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudStack Row="true" Spacing="4" Breakpoint="Breakpoint.Xs">
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileGoalModel.RelationshipIntentions" TValue="HashSet<RelationshipIntention>" TEnum="RelationshipIntention" @bind-SelectedValues="@profile.RelationshipIntentions"
                                             CssIcon="@IconsFA.Solid.Icon("magnifying-glass").Font" Multiple="true">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileGoalModel.Relocation" TValue="Relocation?" TEnum="Relocation" @bind-SelectedValue="@profile.Relocation"
                                             CssIcon="@IconsFA.Solid.Icon("truck").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                        <MudGrid Spacing="@CssHelper.SpaceSmall">
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileGoalModel.WantChildren" TValue="WantChildren?" TEnum="WantChildren" @bind-SelectedValue="@profile.WantChildren"
                                             CssIcon="@IconsFA.Solid.Icon("baby").Font" ShowHelper="false">
                                </FieldSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <FieldSelect Name="@ProfileGoalModel.IdealPlaceToLive" TValue="IdealPlaceToLive?" TEnum="IdealPlaceToLive" @bind-SelectedValue="@profile.IdealPlaceToLive"
                                             CssIcon="@IconsFA.Solid.Icon("house-circle-check").Font">
                                </FieldSelect>
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudForm>

    <MudButton StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" Class="me-2" OnClick="SaveHandle"
               Disabled="@(profile == null || AppStateStatic.Principal == null || AppStateStatic.Principal.PublicProfile)">
        @Translations.Button.Save
        <MudChip T="string" Label="true" Size="Size.Small" Style="height: auto;" Class="ms-2" Color="Color.Info">
            @profile.GetOverallCompletionPercentage().ToString("P0")
        </MudChip>
    </MudButton>

    @if (profile != null && !ProfileHelper.Validator.Validate(profile, options => options.IncludeAllRuleSets()).IsValid)
    {
        <MudButton StartIcon="@Icons.Material.Filled.BugReport" Color="Color.Warning" Variant="Variant.Filled" OnClick="() => ShowErrors(profile)">
            @Translations.Button.ShowPendingItems
        </MudButton>
    }
</RenderControl>

<MudDialog @ref="@MudDialog" Style="width: 100%">
    <DialogContent>
        <MudList T="string" Dense="true">
            <MudListItem Icon="@Icons.Material.Filled.Check" Style="text-align: justify;">
                @Translations.Module.Profile.TermTopic1
            </MudListItem>
            <MudListItem Icon="@Icons.Material.Filled.Check" Style="text-align: justify;">
                @Translations.Module.Profile.TermTopic2 <MudLink Href="@($"/{Culture}/legal/privacy")" Target="_blank" Typo="Typo.body2" Color="Color.Tertiary">@Translations.Module.Legal.PrivacyPolicy</MudLink>;
            </MudListItem>
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(async () => { await MudDialog!.CloseAsync(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>

<FloatingButton StartIcon="@Icons.Material.Filled.PrivacyTip" Color="Color.Info" Side="Side.Right" Position="2"
                OnClick="async () => await MudDialog!.ShowAsync(Translations.Module.Legal.PrivacyTerms, PopupHelper.Options(MaxWidth.ExtraSmall))">
</FloatingButton>
<FloatingButton Template="Template.Back"></FloatingButton>