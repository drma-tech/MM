<MudDialog @ref="@DialogCountries" Style="width: 100%">
    <DialogContent>
        @foreach (var region in SumUsers?.Regions.OrderBy(p => p.Name).ToList() ?? [])
        {
            <MudChip T="string" Label="true" Color="Color.Primary" Size="Size.Small">@region.Name</MudChip>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@DialogCountriesCloseClick">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @ref="@DialogCities" Style="width: 100%">
    <DialogContent>
        @foreach (var region in SumUsers?.Regions.OrderBy(p => p.Name).ToList() ?? [])
        {
            <MudChip T="string" Label="true" Color="Color.Primary" Size="Size.Small">@region.Name</MudChip>
            @foreach (var city in region.Cities.Order().ToList() ?? [])
            {
                <MudChip T="string" Label="true" Color="Color.Secondary" Size="Size.Small">@city</MudChip>
            }
            <br />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@DialogCitiesCloseClick">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "language")]
    public string? Language { get; set; }

    private MudDialog? DialogCountries { get; set; }
    private MudDialog? DialogCities { get; set; }
    public SumUsers? SumUsers { get; set; }

    private ComponentActions<LastUsers> LastUsersActions { get; } = new(obj => obj == null || obj.Items.Empty());
    public LastUsers? LastUsers { get; set; }

    protected override async Task LoadStaticDataAsync()
    {
        var cache = await DashboardApi.GetSumUsers(cts.Token);
        SumUsers = cache?.Data;

        var cache2 = await LastUsersApi.GetLastUsers(cts.Token);
        LastUsers = cache2?.Data;

        await LastUsersActions.FinishLoading.Invoke(LastUsers);

        foreach (var item in LastUsers?.Items ?? [])
        {
            item.CountryObj = item.Country.GetFieldSettings();
        }
    }

    private double GetPhaseValue(int phase)
    {
        var totUsers = SumUsers?.TotalUsers ?? 0;

        if (phase == 1)
        {
            //do nothing
        }
        else if (phase == 2)
        {
            if (totUsers > 10_000) totUsers -= 10_000;
            else return 0;
        }
        else if (phase == 3)
        {
            if (totUsers > 20_000) totUsers -= 20_000;
            else return 0;
        }
        else if (phase == 4)
        {
            if (totUsers > 30_000) totUsers -= 30_000;
            else return 0;
        }

        if (totUsers < 10_000) return (double)totUsers / 10_000;
        else return 1;
    }

    private Color GetPhaseColor(int phase)
    {
        var value = GetPhaseValue(phase);

        if (value == 1) return Color.Success;
        else if (value == 0) return Color.Default;
        else return Color.Primary;
    }

    private async Task Login()
    {
        Navigation.NavigateTo($"/{Culture}/auth/login?returnUrl={Uri.EscapeDataString(Navigation.Uri.Split('#')[0])}");
    }

    private async Task DialogCountriesCloseClick()
    {
        await DialogCountries!.CloseAsync();
    }

    private async Task DialogCitiesCloseClick()
    {
        await DialogCities!.CloseAsync();
    }

