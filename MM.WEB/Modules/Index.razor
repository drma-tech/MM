                                            </MudListSubheader>
                                            <MudListItem>@Translations.Module.Landing.Phase3Opt1</MudListItem>
                                            <MudListItem>@Translations.Module.Landing.Phase3Opt2</MudListItem>
                                        </MudList>
                                    </MudCardContent>
                                </MudCard>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="GetPhaseColor(4)" Size="Size.Medium">
