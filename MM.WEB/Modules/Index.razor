@page "/"
@page "/{culture}"

@using MM.Shared.Models.Dashboard
@using MM.WEB.Modules.Subscription.Core
@inherits PageCore<Index>

@inject DashboardApi DashboardApi
@inject LastUsersApi LastUsersApi
@inject PaymentConfigurationApi ConfigurationApi
@inject IpInfoApi IpInfoApi

<HeadComponent Title="@Translations.Title.AppSubtitle" Description="@Translations.Description.AppDescription" Url=@($"/{Culture}") Index="@Culture.NotEmpty()" Shared="true"></HeadComponent>

<PageSectionComponent IsPageHeader="true" Image="icon/icon-71.png" Title="@AppInfo.Title" Subtitle="@Translations.Title.AppSubtitle" CustomBodyClass="mb-12"></PageSectionComponent>

<MudContainer>
    @if (!AppStateStatic.IsAuthenticated)
    {
        <MudPaper Elevation="2" Class="pa-4 my-12 mud-theme-primary" Style="text-align: center;">
            <MudText Typo="Typo.h4" Align="Align.Center" Class="my-3">
                @Translations.Module.Profile.HeroCall
            </MudText>
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Login" Class="my-4">
                @Translations.Module.Profile.HeroButton
            </MudButton>
            <MudText Typo="Typo.body1" Align="Align.Center" Class="my-3 d-block">
                @Translations.Module.Profile.HeroNote
            </MudText>
        </MudPaper>
    }

    <PageSectionComponent Title="@Translations.Module.Landing.OurNumbers" Subtitle="@Translations.Module.Landing.OurNumbersMsg1" Description="@Translations.Module.Landing.OurNumbersMsg2" CustomBodyClass="mb-12">
        <BodyFragment>
            <MudGrid Spacing="@Css.SpaceSmall">
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardHeader Class="pa-3">
                            <MudText Typo="Typo.h6" Style="font-size: 1.1rem;">
                                @Translations.Module.Landing.Countries
                            </MudText>
                        </MudCardHeader>
                        <MudCardContent Class="py-0 px-3">
                            <MudChip T="string" Icon="@IconsFA.Solid.Icon("earth-americas").Font" Color="Color.Primary" Label="true" Class="chip-no-text-lg" Style="vertical-align: top;" />
                            <MudText Typo="Typo.h4" Inline="true">
                                @(SumUsers?.Countries ?? 0)
                            </MudText>
                        </MudCardContent>
                        <MudCardActions Class="pa-3">
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="AppStateStatic.Size"
                                       OnClick="@(async () => await DialogCountries!.ShowAsync(Translations.Module.Landing.CountriesRegistered, PopupHelper.Options(MaxWidth.Small)))">
                                @Translations.Button.LearnMore
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudCard>
                        <MudCardHeader Class="pa-3">
                            <MudText Typo="Typo.h6" Style="font-size: 1.1rem;">
                                @Translations.Module.Landing.Cities
                            </MudText>
                        </MudCardHeader>
                        <MudCardContent Class="py-0 px-3">
                            <MudChip T="string" Icon="@IconsFA.Solid.Icon("city").Font" Color="Color.Primary" Label="true" Class="chip-no-text-lg" Style="vertical-align: top;" />
                            <MudText Typo="Typo.h4" Inline="true">
                                @(SumUsers?.Cities ?? 0)
                            </MudText>
                        </MudCardContent>
                        <MudCardActions Class="pa-3">
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="AppStateStatic.Size" Disabled="true"
                                       OnClick="@(async () => await DialogCities!.ShowAsync("Users from cities registered so far", PopupHelper.Options(MaxWidth.Small)))">
