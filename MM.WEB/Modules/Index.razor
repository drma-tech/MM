                                                            <MudText Typo="Typo.subtitle1" Color="Color.Dark">
                                                                <b>@tot.ToString("P2")</b>
                                                            </MudText>
                                                        </MudProgressLinear>
                                                    }
                                                </div>
                                            </MudListSubheader>
                                            <MudListItem>@Translations.Module.Landing.Phase2Opt1</MudListItem>
                                            <MudListItem>@Translations.Module.Landing.Phase2Opt3</MudListItem>
                                        </MudList>
                                    </MudCardContent>
                                </MudCard>
                            </ItemContent>
                        </MudTimelineItem>
                        <MudTimelineItem Color="GetPhaseColor(3)" Size="Size.Medium">
