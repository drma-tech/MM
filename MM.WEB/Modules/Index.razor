    <PageSectionComponent Title="@Translations.Module.Landing.OurRoadmap" Subtitle="@Translations.Module.Landing.OurRoadmapMsg1" Description="@Translations.Module.Landing.OurRoadmapMsg2" CustomBodyClass="mb-12">
        <BodyFragment>
            <MudGrid Spacing="@Css.SpaceSmall" Justify="Justify.Center">
                <MudItem xs="12" md="10">
                    <MudTimeline TimelinePosition="@(AppStateStatic.IsMobile ? TimelinePosition.Start : TimelinePosition.Alternate)" Modifiers="true">
                        <MudTimelineItem Color="GetPhaseColor(1)" Size="Size.Medium">
                            <ItemDot>
                                <MudIcon Icon="@IconsFA.Solid.Icon("1").Font" Style="text-align: center;"></MudIcon>
                            </ItemDot>
                            <ItemOpposite>
                                <MudText Color="GetPhaseColor(1)" Typo="Typo.h3" Class="custom-h3-roadmap">@Translations.Module.Landing.Phase1Title</MudText>
                            </ItemOpposite>
                            <ItemContent>
                                @if (AppStateStatic.IsMobile)
                                {
                                    <MudText Color="GetPhaseColor(1)" Typo="Typo.h3" Class="my-2 custom-h3-roadmap">@Translations.Module.Landing.Phase1Title</MudText>
                                }
                                <MudCard Elevation="25">
                                    <MudCardContent>
                                        <MudList T="string" Dense="true">
                                            <MudListSubheader Class="pa-0">
                                                <div>
                                                    @if (SumUsers != null)
                                                    {
                                                        var tot = GetPhaseValue(1);
                                                        <MudProgressLinear Value="(tot * 100)" Color="Color.Info" Striped="@(tot < 1)" Class="my-1" Style="height: 30px;">
                                                            <MudText Typo="Typo.subtitle1" Color="Color.Dark">
                                                                <b>@tot.ToString("P2")</b>
                                                            </MudText>
                                                        </MudProgressLinear>
                                                    }
                                                </div>
                                            </MudListSubheader>
                                            <MudListItem>@Translations.Module.Landing.Phase1Opt1</MudListItem>
                                            <MudListItem>@Translations.Module.Landing.Phase1Opt2</MudListItem>
                                            <MudListItem>@Translations.Module.Landing.Phase1Opt3</MudListItem>
                                        </MudList>
                                    </MudCardContent>
                                </MudCard>
                            </ItemContent>
                        </MudTimelineItem>
