    <PageSectionComponent Title="Detailed Breakdown">
        <BodyFragment>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">
                Dating Apps
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Justify">
                Dating apps make it easy to browse profiles, discover people, and start conversations. Their experience often revolves around photos, short bios, likes, and filters. This gives users plenty of ways to meet people, but finding someone whose values, lifestyle, and relationship goals align can take time and effort.
            </MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-4 mb-2">
                Traditional Matchmaking
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Justify">
                Traditional matchmaking services use personal consultations and human expertise to introduce potential partners. This can provide a tailored experience, although the available matches depend on each matchmaker's network, and the service often comes with a higher price.
            </MudText>
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-4 mb-2">
                Modern Matchmaker
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Justify">
                Modern Matchmaker offers a compatibility-based dating and online matchmaking experience designed for people seeking meaningful connections and serious relationships. Detailed profiles capture lifestyle, values, personality, and relationship goals, helping assess compatibility beyond photos and basic filters. A visible compatibility score makes that alignment easier to understand, while global matchmaking opens the door to connections beyond local dating pools. The platform also uses profile, identity, and behavior checks to support trust and help users make more informed decisions. These checks are part of the platform's safety approach and should not be understood as a guarantee of another person's intentions or conduct.
            </MudText>
        </BodyFragment>
    </PageSectionComponent>
    <PageSectionComponent Title="Why Modern Matchmaker is Different">
        <BodyFragment>
            <div class="support-section mb-0">
                <ul>
                    <li>
                        <MudText Typo="Typo.body1">
                            Compatibility built around lifestyle, values, and relationship goals
                        </MudText>
                    </li>
                    <li>
                        <MudText Typo="Typo.body1">
                            Detailed profiles that go beyond photos and short bios
                        </MudText>
                    </li>
                    <li>
                        <MudText Typo="Typo.body1">
                            A visible compatibility score for more transparent matching
                        </MudText>
                    </li>
                    <li>
                        <MudText Typo="Typo.body1">
                            Global matchmaking that expands your dating possibilities
                        </MudText>
                    </li>
                    <li>
                        <MudText Typo="Typo.body1">
                            Profile, identity, and behavior verification checks, combined with pay-per-use access and no recurring subscription commitment
                        </MudText>
                    </li>
                </ul>
            </div>
        </BodyFragment>
    </PageSectionComponent>
}

@if (!AppStateStatic.IsAuthenticated)
{
    <MudPaper Elevation="2" Class="pa-4 my-12 mud-theme-primary" Style="text-align: center;">
        <MudText Typo="Typo.h6" Align="Align.Center" Class="my-3">
            @Translations.Module.Landing.CompareCall2
        </MudText>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="Login" Class="my-4">
            @Translations.Module.Profile.HeroButton
        </MudButton>
    </MudPaper>
}

<FloatingButton Template="Template.Back"></FloatingButton>

@code {
    public AppLanguage Language => AppStateStatic.ConvertAppLanguage(Culture, AppLanguage.en);

    private async Task Login()
    {
        try
        {
            await JsRuntime.Clerk().SignInAsync(Cts.Token);
        }
        catch (Exception ex)
        {
            await ProcessException(ex);
        }
    }
}
