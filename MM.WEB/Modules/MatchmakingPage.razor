@page "/{culture}/matchmaking/{region}"

@inherits PageCore<MatchmakingPage>

@inject LastRegionUsersApi LastRegionUsersApi

<HeadComponent Title="@(Translations.Title.Matchmaker.CustomFormat(CountryEnum?.GetFieldSettings().Name))" Description="@(Translations.Description.LastUsers.CustomFormat(CountryEnum?.GetFieldSettings().Name))"
               Url=@($"/{Culture}/matchmaking/{Region}") Index="true" FixedAlternateLanguage="@Culture"></HeadComponent>

<PageSectionComponent IsPageHeader="true" Image="icon/icon-71.png" Title="@(Translations.Title.Matchmaker.CustomFormat(CountryEnum?.GetFieldSettings().Name))"
                      Description="@(Translations.Description.LastUsers.CustomFormat(CountryEnum?.GetFieldSettings().Name))" CustomBodyClass="mb-12"></PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Landing.PopularLocations" Color="Color.Secondary">
    <BodyFragment>
        @foreach (var item in LastUsers?.Items.Select(p => p.State).Where(p => p.NotEmpty()).Distinct() ?? [])
        {
            <MudChip T="string" Label="true" Color="Color.Primary" Size="AppStateStatic.Size">
                @item
            </MudChip>
        }
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Landing.RecentlyJoined" Color="Color.Secondary">
    <BodyFragment>
        <RenderControl State="LastUsersState" LoadingHeight="130px">
            <MudGrid Spacing="@CssHelper.SpaceSmall" Class="mb-2">
                @foreach (var item in LastUsers?.Items ?? [])
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudLink OnClick="@(async () => await DialogService!.OpenPopupProfile(MM.Shared.Enums.Origin.Highlight, AppStateStatic.UserId, item.Id, null, true))"
                                 style="display: flex; gap: 8px;" Disabled="@item.Nickname.Empty()">
                            <MudAvatar Size="Size.Large" Style="width: 66px; height: 66px;">
                                <MudImage Src="images/no-face-photo.webp" Alt="@(item.Nickname ?? Translations.Module.Landing.NoProfile)" FallbackSrc="images/no-face-photo.webp" Style="width: 66px;">
                                </MudImage>
                            </MudAvatar>
                            <div style="align-content: center;">
                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Style="line-height: normal;">
                                    @(item.Nickname ?? Translations.Module.Landing.NoProfile)
                                </MudText>
                                <MudText Typo="Typo.body1" Color=Color.Tertiary Style="line-height: normal; font-size: small;">
                                    @(item.State)
                                </MudText>
                            </div>
                        </MudLink>
                    </MudItem>
                }
            </MudGrid>
        </RenderControl>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Landing.LearnMoreAboutMM" Color="Color.Secondary">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href=@($"/{Culture}/help/faq") rel="nofollow">
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Chat"></MudIcon>
                    Browse FAQ
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href=@($"/{Culture}/how-it-works")>
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Info"></MudIcon>
                    @Translations.Title.HowItWorks
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href=@($"/{Culture}/who-its-for")>
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Info"></MudIcon>
                    @Translations.Title.WhoIsItFor
                </MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudButton Variant="Variant.Filled" FullWidth="true" Href=@($"/{Culture}/compare")>
                    <MudIcon Class="me-2" Icon="@Icons.Material.Filled.Checklist"></MudIcon>
                    @Translations.Title.Compare
                </MudButton>
            </MudItem>
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>

<PageSectionComponent Title="@Translations.Module.Landing.AvailableYourDevices" Color="Color.Secondary">
    <BodyFragment>
        <MudGrid Spacing="@CssHelper.SpaceSmall">
            @foreach (var store in AppInfo.Stores)
            {
                if (CurrentPlatform == MM.Shared.Enums.Platform.ios)
                {
                    if (store.Platform == MM.Shared.Enums.Platform.play)
                    {
                        continue;
                    }
                }

                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudButton Variant="Variant.Filled" FullWidth="true" Href="@store.Url" Target="_blank" rel="noopener">
                        <MudImage Src="@store.Logo" Class="me-2" Style="width: 20px; vertical-align: top;" Alt="@store.Store" />
                        @store.Store
                    </MudButton>
                </MudItem>
            }
        </MudGrid>
    </BodyFragment>
</PageSectionComponent>

@if (!AppStateStatic.IsAuthenticated)
{
    <MudPaper Class="@CssHelper.Build().Medium("pa").Large("mb").Raw("mud-theme-primary")" Outlined="true" Style="text-align: center;">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="my-3">
            @Translations.Module.Profile.HeroCall
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="Login" Class="my-4">
            @Translations.Module.Profile.HeroButton
        </MudButton>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="my-3 d-block">
            @Translations.Module.Profile.HeroNote
        </MudText>
    </MudPaper>
}