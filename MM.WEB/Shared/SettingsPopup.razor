@inherits ComponentCore<SettingsPopup>

<MudDialog Style="width: 100%">
    <DialogContent>
        <MudGrid Spacing="@CssHelper.SpaceMedium">
            <MudItem xs="12">
                <MudSelect T="AppLanguage" Value="@Language" ValueChanged="@AppLanguageValueChanged" Label="@Translations.Module.Help.AppLanguage"
                           HelperText="@Translations.Module.Help.AppLanguageDesc" FullWidth="true">
                    @foreach (var item in appLanguages.OrderBy(p => p.Name))
                    {
                        <MudSelectItem Value="@item.Value">@item.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudText Class="mb-1" Style="font-size: 14px;">@Translations.Module.Help.AppTheme</MudText>
                <MudToggleGroup T="bool" Value="DarkMode" ValueChanged="@DarkModeChanged" SelectionMode="SelectionMode.SingleSelection"
                                Vertical="false" Color="Color.Primary">
                    <MudToggleItem Value="false">
                        <MudIcon Icon="@Icons.Material.Filled.LightMode" Title="@Translations.Module.Help.LightMode" Class="me-1"></MudIcon>
                        @Translations.Module.Help.LightMode
                    </MudToggleItem>
                    <MudToggleItem Value="true">
                        <MudIcon Icon="@Icons.Material.Filled.DarkMode" Title="@Translations.Module.Help.DarkMode" Class="me-1"></MudIcon>
                        @Translations.Module.Help.DarkMode
                    </MudToggleItem>
                </MudToggleGroup>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => { MudDialog?.Close(); })">
            @Translations.Button.Close
        </MudButton>
    </DialogActions>
</MudDialog>