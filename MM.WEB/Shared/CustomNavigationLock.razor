@using Microsoft.AspNetCore.Components.Routing

@inject IDialogService Dialogs

<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="OnLocationChanging" />

@code {
    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public string? CustomMessage { get; set; }

    private async Task OnLocationChanging(LocationChangingContext context)
    {
        //https://learn.microsoft.com/en-us/aspnet/core/blazor/fundamentals/navigation?view=aspnetcore-10.0#handleprevent-location-changes

        if (IsDirty)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(AppInfo.Title, CustomMessage ?? "You may lose unsaved changes. Do you want to continue?", Translations.Button.Ok, Translations.Button.Cancel) ?? false;

            if (!confirmed)
            {
                context.PreventNavigation();
            }
        }
    }
}
