  <data name="OurNumbersMsg2" xml:space="preserve">
    <value>Jedes neue Mitglied bringt uns unserem nächsten Meilenstein näher. Werden Sie früh Teil unserer Community und gestalten Sie die Zukunft der Partnervermittlung mit.</value>
  </data>
  <data name="OurRoadmap" xml:space="preserve">
